# Copy this file to .env and change every value:   cp .env.example .env
# .env is in .gitignore, so your passwords never reach GitHub.
#
# Password rules (SQL Server): at least 8 characters with characters from at
# least 3 of: uppercase, lowercase, numbers, symbols.
# Safe symbols: - ! _ . @ %     Avoid: $ ' " ; = # \ and spaces

# SQL Server administrator (sa): used only to create and load the database
SA_PASSWORD=Change-Me-Sa-2026

# Password for student_app, the EXECUTE-only login the web app uses
APP_DB_PASSWORD=Change-Me-App-2026

# Your sign-in for the website
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Change-Me-Web-2026
