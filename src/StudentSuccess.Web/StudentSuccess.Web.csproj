<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets `dotnet user-secrets` keep passwords out of source control -->
    <UserSecretsId>dd747302-cb31-4b20-a0c9-23b10ea87939</UserSecretsId>
    <!-- The /// comments on API actions become descriptions in the API docs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the OpenAPI document at /openapi/v1.json -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Microsoft's SQL Server driver for .NET (ADO.NET) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StudentSuccess.Tests" />
  </ItemGroup>

</Project>
