@model LoginForm
@{
    ViewData["Title"] = "Sign in";
    var notConfigured = ViewData["NotConfigured"] as bool? == true;
}

<div class="login">
    <h1>Sign in</h1>
    <p class="lede">This tool shows student records, so staff must sign in.</p>

    @if (notConfigured)
    {
        <p class="flash flash-error" role="alert">Sign-in is turned off because no password is configured. Set <code>ADMIN_PASSWORD</code> in <code>.env</code> and restart.</p>
    }

    <form asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="error-summary" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn">Sign in</button>
    </form>
</div>
